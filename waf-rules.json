{
  "rules": [
    {"name": "路径穿越", "pattern": "(?i)(\\.\\./|\\.\\.\\\\|%2e%2e|%2e%2f|%252e|%c0%af|%c1%9c)", "strict": false},
    {"name": "命令注入", "pattern": "(?i)(;\\s*(cmd|powershell|pwsh|bash|sh|wget|curl|net|taskkill|ping|rm|rmdir)\\b|&&\\s*(cmd|powershell|pwsh|bash|sh|wget|curl|net|taskkill|ping|rm|rmdir)\\b|;\\s*\\x60[a-z]+\\x60)", "strict": false},
    {"name": "SQL 注入", "pattern": "(?i)(\\bunion\\b\\s+\\bselect\\b|\\binsert\\b\\s+\\binto\\b|\\bdelete\\b\\s+\\bfrom\\b|\\bdrop\\b\\s+\\btable\\b|/\\*|;\\s*\\bdrop\\b|\\bsleep\\s*\\(|\\bbenchmark\\s*\\()", "strict": true},
    {"name": "XSS", "pattern": "(?i)(<\\s*script|javascript\\s*:|onerror\\s*=|onload\\s*=|<\\s*iframe|document\\.cookie|<\\s*object)", "strict": true},
    {"name": "PromptInjection", "pattern": "(?i)(ignore\\s+(previous|above|prior)|disregard\\s+(instructions|rules)|you\\s+are\\s+now|DAN\\s+mode|jailbreak|\\bsystem\\s*:\\s*you\\s+are|\\bdeveloper\\s*mode\\b|\\bdo\\s+anything\\s+now\\b|\\bnew\\s+instructions\\s*:\\s*)", "strict": true},
    {"name": "PII泄漏", "pattern": "\\b\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b|\\b\\d{3}-\\d{2}-\\d{4}\\b|\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b|\\b1[3-9]\\d{9}\\b", "strict": true}
  ]
}
