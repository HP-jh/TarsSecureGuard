<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="日志管理"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView android:id="@+id/logs_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="点击刷新加载日志列表" android:textSize="14sp"
        android:textColor="#666" android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/logs_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_refresh_logs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="刷新"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_share_log"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="分享选中"
            android:layout_marginStart="4dp" />

    </LinearLayout>
</LinearLayout>
