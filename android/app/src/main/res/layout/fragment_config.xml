<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务配置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="监听地址" android:textSize="14sp" android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/config_addr"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="127.0.0.1:18080" android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="最大日志大小 (MB)" android:textSize="14sp" android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/config_maxlog"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="10" android:inputType="number"
            android:layout_marginBottom="16dp" />

        <Switch android:id="@+id/config_gateway"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="启动时启用网关" android:layout_marginBottom="8dp" />

        <Switch android:id="@+id/config_autostart"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="开机自启动" android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_save_config"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="保存配置" />

        <TextView android:id="@+id/config_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="14sp"
            android:textColor="#666" android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
