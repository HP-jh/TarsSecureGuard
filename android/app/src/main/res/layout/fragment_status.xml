<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务状态"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView android:id="@+id/status_running"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="运行中：" android:textSize="16sp"
            android:padding="12dp" android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/status_uptime"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="运行时长：" android:textSize="16sp"
            android:padding="12dp" android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/status_agents"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="注册代理：" android:textSize="16sp"
            android:padding="12dp" android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/status_devices"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="发现设备：" android:textSize="16sp"
            android:padding="12dp" android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/status_quarantined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="隔离节点：" android:textSize="16sp"
            android:padding="12dp" android:background="#F5F5F5"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="刷新" />

    </LinearLayout>
</ScrollView>
