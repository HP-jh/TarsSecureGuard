{
  "id": "perplexity",
  "name": "Perplexity",
  "kind": "cloud",
  "protocol": "openai-compat",
  "baseURL": "https://api.perplexity.ai",
  "chatPath": "/chat/completions",
  "keyEnv": "TARS_PERPLEXITY_KEY",
  "docs": "https://docs.perplexity.ai/api-reference/chat-completions",
  "models": [
    "sonar",
    "sonar-pro",
    "sonar-reasoning"
  ],
  "notes": "OpenAI 兼容（注意 baseURL 无 /v1）",
  "applyUrl": "https://www.perplexity.ai/settings/api",
  "defaultCaps": [
    "tools"
  ],
  "modelCaps": {
    "sonar-reasoning": [
      "reasoning",
      "tools"
    ]
  },
  "pricing": {
    "input": 1.0,
    "output": 1.0
  }
}
