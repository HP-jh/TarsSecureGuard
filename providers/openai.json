{
  "id": "openai",
  "name": "OpenAI",
  "kind": "cloud",
  "protocol": "openai-compat",
  "baseURL": "https://api.openai.com/v1",
  "chatPath": "/chat/completions",
  "keyEnv": "TARS_OPENAI_KEY",
  "docs": "https://platform.openai.com/docs/api-reference/chat",
  "models": [
    "gpt-4o",
    "gpt-4o-mini",
    "gpt-4.1",
    "o3"
  ],
  "notes": "官方 API；模型名以官网为准",
  "applyUrl": "https://platform.openai.com/api-keys",
  "modelCaps": {
    "gpt-4o": [
      "vision",
      "tools",
      "json",
      "longContext"
    ],
    "gpt-4o-mini": [
      "vision",
      "tools",
      "json"
    ],
    "gpt-4.1": [
      "vision",
      "tools",
      "json",
      "longContext"
    ],
    "o3": [
      "reasoning",
      "tools",
      "vision",
      "longContext"
    ]
  },
  "pricing": {
    "input": 2.5,
    "output": 10.0
  },
  "modelPricing": {
    "gpt-4o-mini": {
      "input": 0.15,
      "output": 0.6
    },
    "gpt-4.1": {
      "input": 2.0,
      "output": 8.0
    }
  }
}
