{
  "id": "google-gemini",
  "name": "Google Gemini",
  "kind": "cloud",
  "protocol": "gemini",
  "baseURL": "https://generativelanguage.googleapis.com",
  "chatPath": "/v1beta/models/{model}:generateContent",
  "keyEnv": "TARS_GEMINI_KEY",
  "docs": "https://ai.google.dev/api/generate-content",
  "models": [
    "gemini-2.5-pro",
    "gemini-2.5-flash"
  ],
  "notes": "原生 generateContent；密钥经 x-goog-api-key 头发送",
  "applyUrl": "https://aistudio.google.com/",
  "defaultCaps": [
    "vision",
    "tools",
    "json",
    "longContext"
  ],
  "pricing": {
    "input": 1.25,
    "output": 5.0
  },
  "modelPricing": {
    "gemini-2.5-flash": {
      "input": 0.3,
      "output": 2.5
    }
  }
}
