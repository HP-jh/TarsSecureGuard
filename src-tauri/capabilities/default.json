{
  "identifier": "default",
  "description": "v4.11.0：前端为纯 Web UI；sidecar 由 Rust 侧拉起。权限集扩展 tray / updater / event 广播（最小够用）。",
  "windows": ["main", "loading"],
  "permissions": [
    "core:default",
    "core:app:allow-default-window-icon",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:event:allow-emit",
    "core:tray:default",
    "shell:allow-open",
    "updater:default"
  ]
}
