{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TarsSecureGuard",
  "version": "4.6.0",
  "identifier": "io.github.hp-jh.tarssecureguard",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TarsSecureGuard 控制台",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tsg"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/128x128.png",
        "headerImage": "icons/128x128.png"
      },
      "msi": {
        "upgradeCode": "c0a8b7d6-e5f4-4a3b-9c2d-1e0f8a7b6c5d"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": "src-tauri/entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "binaries/tsg",
          "sidecar": true,
          "args": ["--no-browser"]
        }
      ]
    },
    "deep-link": {
      "mobile": false,
      "desktop": {
        "schemes": ["tsg", "tsg-installer"]
      }
    }
  }
}
