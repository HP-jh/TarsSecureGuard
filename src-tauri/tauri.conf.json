{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TarsSecureGuard",
  "version": "3.2.1",
  "identifier": "io.github.hp-jh.tarssecureguard",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TarsSecureGuard 控制台",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tsg"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "binaries/tsg",
          "sidecar": true,
          "args": ["--no-browser"]
        }
      ]
    }
  }
}
