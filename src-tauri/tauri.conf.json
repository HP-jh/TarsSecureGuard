{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TarsSecureGuard",
  "version": "4.11.0",
  "identifier": "io.github.hp-jh.tarssecureguard",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "loading",
        "title": "TarsSecureGuard",
        "width": 800,
        "height": 500,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "visible": true,
        "transparent": false,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "TarsSecureGuard 控制台",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-green.png",
      "tooltip": "TarsSecureGuard 桌面客户端"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tsg"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/128x128.png",
        "headerImage": "icons/128x128.png"
      },
      "requestedExecutionLevel": "requireAdministrator"
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": "src-tauri/entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "binaries/tsg",
          "sidecar": true,
          "args": ["--no-browser"]
        }
      ]
    },
    "deep-link": {
      "mobile": false,
      "desktop": {
        "schemes": ["tsg", "tsg-installer"]
      }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": ["https://api.github.com/repos/HP-jh/TarsSecureGuard/releases/latest"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNUQyRjZCQjAyQjU1M0QK"
    }
  }
}
